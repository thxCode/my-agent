 import os
 import sys
 import json
+from abc import ABC, abstractmethod
 from pathlib import Path

+import dotenv
+

 def load(path: Path) -> dict:
-    return json.loads(path.read_text())
+    if not path.exists():
+        return {}
+    return json.loads(path.read_text())
+
+
+class SettingsSource(ABC):
+    """Where a layer of settings comes from."""
+
+    @abstractmethod
+    def read(self) -> dict: ...
+
+
+class FileSource(SettingsSource):
+    def __init__(self, path: Path) -> None:
+        self._path = path
+
+    def read(self) -> dict:
+        return load(self._path)
+
+
+def dedupe(names: list[str]) -> list[str]:
+    seen: list[str] = []
+    for name in names:
+        if name not in seen:
+            seen.append(name)
+    return seen
+
+
+def merge_layers(layers: list[dict]) -> dict:
+    """Later layers win."""
+    merged: dict = {}
+    for i in range(1, len(layers)):
+        merged.update(layers[i])
+    return merged
+
+
+def env_overrides(prefix: str) -> dict:
+    dotenv.load_dotenv()
+    return {k[len(prefix):].lower(): v for k, v in os.environ.items() if k.startswith(prefix)}  # noqa: E501
+
+
+def resolve(paths: list[Path], prefix: str) -> dict:
+    # shortcut: re-reads every file on each call, add caching if this lands in a hot path
+    sources = [FileSource(Path(p)) for p in dedupe([str(p) for p in paths])]
+    layers = [s.read() for s in sources]
+    layers.append(env_overrides(prefix))
+    return merge_layers(layers)


 def dump(cfg: dict) -> str:
     return json.dumps(cfg, indent=2, sort_keys=True)
